# ─────────────────────────────────────────────────────────────────────────────
# api-legacy — the deployment that serves the EXISTING Abhigyan applications
# ─────────────────────────────────────────────────────────────────────────────
#
# Built from platform-core at tag `legacy/v1.0`. Deploys manually, from a tag,
# and receives security patches only. It exists so that changes made for the
# platform cannot reach the clients that cannot be updated: abhigyan-gurukul-app
# v1.0.3 is installed on real phones, and some of those will never update.
#
# Copy the FULL existing production environment first, then apply the settings
# below. Every variable not listed here keeps its current production value.
#
# THIS FILE IS AN EXAMPLE. It contains no secrets and is safe to commit.

# ── Tenancy ──────────────────────────────────────────────────────────────────

# `pinned` fixes the tenant context to one organization for every request.
#
# This is NOT a "default org" fallback. The distinction is what keeps the
# fail-closed rule intact: in pinned mode a context is always present and always
# explicit, so there is no code path where a MISSING context silently resolves
# to an organization. The legacy app knows nothing about organizations and does
# not need to — the server supplies the answer.
TENANT_MODE=pinned

# Org 001, from `npm run safety:seed-org -- --production`.
# Requests are refused with 503 while this is unset, because serving unscoped
# and calling it "pinned" would be a lie.
ORG_ID=

# Stays `warn` for the whole migration: the context is established and unscoped
# access is recorded, but NO read is filtered. Flipping this to `enforce` here
# is not part of the plan — the legacy deployment is the thing being protected,
# not the thing being migrated.
TENANT_ENFORCEMENT=warn

# ── Scheduled work ───────────────────────────────────────────────────────────

# Cron runs on api-platform ONLY. Both deployments share one database, so if
# both scheduled the same jobs Abhigyan would get two attendance syncs and two
# EOD reminders every day. Duplicate side effects look like data corruption and
# are miserable to trace.
#
# `shouldRunScheduledJobs()` already returns false for an explicit
# TENANT_MODE=pinned; this is belt and braces, and it documents the intent at
# the place an operator actually looks.
ENABLE_CRON=false

# The AI pipeline worker also belongs to the platform deployment.
PPT_WORKER_EMBEDDED=false

# ── Attendance webhook ───────────────────────────────────────────────────────

# Left OFF. Investigation on 2026-08-17 established that eTimeOffice is
# pull-only and this endpoint has never received a single request in seven
# months of production data. See WebhookController.ts for the full evidence.
ENABLE_ATTENDANCE_WEBHOOK=false

# ── Unchanged from production ────────────────────────────────────────────────
# MONGO_URI          — the SAME database as api-platform. Not a copy.
#                      Forking it would mean every exam Abhigyan runs on legacy
#                      is data the platform does not have, and reconciling live
#                      academic records has no correct answer for conflicts.
# JWT_SECRET         — must match api-platform, or tokens minted by one are
#                      rejected by the other.
# REDIS_URL          — shared.
# FIREBASE_*         — shared project.
# CORS_ORIGIN        — must keep allowing the existing web origins.
# ETIMEOFFICE_*      — the live attendance pull runs from api-platform's cron,
#                      but the credentials stay here too so a manual sync
#                      triggered through the admin UI still works.
