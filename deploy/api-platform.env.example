# ─────────────────────────────────────────────────────────────────────────────
# api-platform — the tenant-aware deployment for the NEW clients
# ─────────────────────────────────────────────────────────────────────────────
#
# Built from platform-core at `main`, deployed automatically on merge, gated by
# the isolation suite. Serves client-platform-web, client-platform-app and
# platform-console. No existing Abhigyan client points here.
#
# Same codebase and the SAME DATABASE as api-legacy — the difference is entirely
# in this file.
#
# THIS FILE IS AN EXAMPLE. It contains no secrets and is safe to commit.

# ── Tenancy ──────────────────────────────────────────────────────────────────

# The organization comes from the signed `orgId` claim in the caller's token.
# A signed claim cannot be forged; a header can, which is why a host or header
# is consulted only before authentication, and why a claim and a host that
# DISAGREE are rejected rather than reconciled.
TENANT_MODE=claim

# Not used in claim mode. Left blank deliberately: setting it here would imply
# a fallback organization exists, and it must not.
ORG_ID=

# ── The migration switch ─────────────────────────────────────────────────────
#
#   warn     Context established, unscoped access recorded, NO read filtered.
#            This is the ONLY correct value until the production backfill has
#            completed. Filtering reads before every document carries an orgId
#            matches nothing and blanks every screen.
#
#   enforce  Reads filtered, writes stamped, missing context throws.
#
# Order is not negotiable:
#   1. api-legacy running in pinned mode, verified writing documents with orgId
#   2. production backfill complete and verified
#   3. only then flip this to `enforce`
#
# Reversing 1 and 3 makes the legacy app's writes fail against a schema that now
# requires a field its build does not set — breaking the exact system this whole
# architecture exists to protect.
TENANT_ENFORCEMENT=warn

# ── Scheduled work ───────────────────────────────────────────────────────────

# Cron lives here, and only here. `forEachOrg` enumerates organizations and runs
# each inside its own context, isolating failures so one tenant's bad
# integration credential cannot stop attendance sync for everyone else.
#
# While no Org documents exist it runs once with no context — exactly today's
# behaviour — so switching this on cannot silently stop the syncs.
ENABLE_CRON=true

# Long term this belongs in a dedicated `scheduler` service: the jobs currently
# start with the process, so every horizontally scaled replica would run them.
# That is a latent duplicate-cron bug the moment there is more than one
# instance, and it is worth separating before scaling this deployment.

# The AI pipeline worker runs embedded by default; set false and run
# `npm run start:worker:ppt` separately when PDF rasterization load justifies it.
PPT_WORKER_EMBEDDED=true

# ── Attendance webhook ───────────────────────────────────────────────────────

# OFF. Enabling it requires BOTH secrets below; the handler refuses with 503
# rather than degrading to the unauthenticated behaviour it used to have.
# Tenant identity is taken from ATTENDANCE_WEBHOOK_ORG_ID, never from the
# studentId in the payload — an attacker chooses that field.
ENABLE_ATTENDANCE_WEBHOOK=false
ATTENDANCE_WEBHOOK_SECRET=
ATTENDANCE_WEBHOOK_ORG_ID=

# ── Shared with api-legacy ───────────────────────────────────────────────────
# MONGO_URI     — the SAME database. Abhigyan's data IS Org 001's data.
# JWT_SECRET    — must be identical, or tokens do not cross deployments.
# REDIS_URL     — shared. Cache keys are prefixed `t:{orgId}:`.
# FIREBASE_*    — shared project; isolation is by `orgs/{orgId}/` path prefix.

# ── New for the platform ─────────────────────────────────────────────────────
# CORS_ORIGIN   — the new client hosts. Resolved per-tenant from Org.domains in
#                 P4; until then this must list them explicitly rather than
#                 relying on the `*.vercel.app` wildcard, which trusts every
#                 preview deployment on a public platform.
