# Server Configuration
NODE_ENV=development
PORT=5000
WORKER_PROCESSES=4

# Redis (Required for horizontal scaling)
# Local: redis://localhost:6379
# Render: redis://red-xxx.render.com:6379
# Redis Cloud: redis://default:pass@redis-12345.cloud.redislabs.com:12345
REDIS_URL=redis://localhost:6379

# MongoDB
MONGO_URI=mongodb://localhost:27017/cbt_exam
# MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/dbname?retryWrites=true&w=majority
# Optional fallback when mongodb+srv SRV DNS lookup fails on some networks
# MONGO_URI_DIRECT=mongodb://host1:27017,host2:27017,host3:27017/dbname?replicaSet=atlas-xxxxx-shard-0&ssl=true&authSource=admin&retryWrites=true&w=majority
# Comma-separated DNS resolvers used by Node for SRV lookups
MONGO_DNS_SERVERS=8.8.8.8,1.1.1.1

# JWT Secret
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# CORS Origin (comma-separated)
CORS_ORIGIN=http://localhost:3000,http://localhost:8081

# Admin Seeding
ADMIN_EMAIL=admin@cbt.local
ADMIN_PASSWORD=Admin@123
ADMIN_NAME=System Admin

# ── AI Engine (NVIDIA primary, Ollama fallback) ──────────────────────────────
# Active provider: 'nvidia' (cloud, default) or 'ollama' (local/offline).
AI_PROVIDER=nvidia

# NVIDIA API Catalog (OpenAI-compatible endpoint)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Generation / writing model. NVIDIA_MODEL_GENERATION is preferred; the legacy
# NVIDIA_MODEL_PRIMARY is still read as a fallback for older deployments.
NVIDIA_MODEL_GENERATION=nvidia/llama-3.3-nemotron-super-49b-v1.5
NVIDIA_MODEL_PRIMARY=nvidia/llama-3.3-nemotron-super-49b-v1.5
NVIDIA_MODEL_VISION=meta/llama-3.2-90b-vision-instruct   # OCR + diagram analysis (image-only)
# Small/fast model for metadata, JSON formatting, validation, small rewrites.
NVIDIA_MODEL_FAST=nvidia/llama-3.1-nemotron-nano-8b-v1
NVIDIA_TEMPERATURE=0.2
NVIDIA_TOP_P=0.95
NVIDIA_MAX_TOKENS=8192
NVIDIA_TIMEOUT_MS=1200000         # 20 min — 49B model is slow on big prompts; keep high
NVIDIA_MAX_RETRIES=1
NVIDIA_CONCURRENCY=3
NVIDIA_REASONING=off                  # nemotron 'detailed thinking on|off' (keep off for JSON)
# Optional cost tracking (USD per 1M tokens; 0 = unknown)
NVIDIA_COST_INPUT_PER_M=0
NVIDIA_COST_OUTPUT_PER_M=0

# Ollama (local fallback / offline mode)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_VISION_MODEL=                  # optional local VLM for vision fallback (e.g. llama3.2-vision)

# ── AI PPT pipeline (async, BullMQ + Redis — see src/workers/pptWorkerCore.ts) ──
# The queue worker runs EMBEDDED in the API server by default: `npm start` alone
# is a complete deployment. To isolate the CPU-heavy pipeline instead, set
# PPT_WORKER_EMBEDDED=false here and run `npm run start:worker:ppt` (or
# dev:worker:ppt) as its own process — it consumes the "ai-ppt-pipeline" queue.
PPT_WORKER_EMBEDDED=true
PPT_WORKER_CONCURRENCY=2              # concurrent ppt jobs per worker instance

# ── Import engine (Smart Import) performance ─────────────────────────────────
AI_ENHANCER_CONCURRENCY=6            # parallel AI requests for cloud (NVIDIA); auto-1 for Ollama
AI_ENHANCER_BATCH_SIZE=4             # questions per AI request for cloud; auto-1 for Ollama
AI_ENHANCER_MAX_RETRIES=2            # per-block retries before fail-soft (keep raw + needsReview)
IMPORT_CACHE_ENABLED=true           # cache extracted/enhanced results in Redis
IMPORT_CACHE_TTL_DAYS=30
# Frontend (cbt-exam) poll interval for live progress:
#   NEXT_PUBLIC_IMPORT_POLL_MS=1500

# Firebase Admin
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# Rate Limiting (optional overrides)
MAX_CONNECTIONS=10000
MAX_ROOMS_PER_SOCKET=50
MAX_MESSAGES_PER_MINUTE=30
