# Server Configuration
NODE_ENV=development
PORT=5000
WORKER_PROCESSES=4

# Redis (Required for horizontal scaling)
# Local: redis://localhost:6379
# Render: redis://red-xxx.render.com:6379
# Redis Cloud: redis://default:pass@redis-12345.cloud.redislabs.com:12345
REDIS_URL=redis://localhost:6379

# MongoDB
MONGO_URI=mongodb://localhost:27017/cbt_exam
# MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/dbname?retryWrites=true&w=majority
# Optional fallback when mongodb+srv SRV DNS lookup fails on some networks
# MONGO_URI_DIRECT=mongodb://host1:27017,host2:27017,host3:27017/dbname?replicaSet=atlas-xxxxx-shard-0&ssl=true&authSource=admin&retryWrites=true&w=majority
# Comma-separated DNS resolvers used by Node for SRV lookups
MONGO_DNS_SERVERS=8.8.8.8,1.1.1.1

# JWT Secret
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# CORS Origin (comma-separated)
CORS_ORIGIN=http://localhost:3000,http://localhost:8081

# Admin Seeding
ADMIN_EMAIL=admin@cbt.local
ADMIN_PASSWORD=Admin@123
ADMIN_NAME=System Admin

# ── AI Engine (NVIDIA primary, Ollama fallback) ──────────────────────────────
# Active provider: 'nvidia' (cloud, default) or 'ollama' (local/offline).
AI_PROVIDER=nvidia

# ── Feature toggles (config/features.ts) ─────────────────────────────────────
# AI PPT generation + regeneration. Temporarily OFF (postponed until the core
# platform is stable). ALL code/routes/models/queue stay intact — flip to
# true to bring the feature straight back. Question-paper generation is a
# separate feature and is NOT affected by this flag.
ENABLE_PPT_FEATURES=false

# NVIDIA API Catalog (OpenAI-compatible endpoint)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Generation / writing model. NVIDIA_MODEL_GENERATION is preferred; the legacy
# NVIDIA_MODEL_PRIMARY is still read as a fallback for older deployments.
NVIDIA_MODEL_GENERATION=nvidia/llama-3.3-nemotron-super-49b-v1.5
NVIDIA_MODEL_PRIMARY=nvidia/llama-3.3-nemotron-super-49b-v1.5
NVIDIA_MODEL_VISION=meta/llama-3.2-90b-vision-instruct   # OCR + diagram analysis (image-only)
# Schedule Image Auto-Extraction (Custom Schedule → Upload Schedule) table reader.
# Separate from NVIDIA_MODEL_VISION so it doesn't affect other vision callers.
NVIDIA_MODEL_SCHEDULE_VISION=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
# Small/fast model for metadata, JSON formatting, validation, small rewrites.
# (llama-3.1-nemotron-nano-8b-v1 went dead on the NVIDIA API 2026-07 — hangs.)
NVIDIA_MODEL_FAST=nvidia/nvidia-nemotron-nano-9b-v2
NVIDIA_TEMPERATURE=0.2
NVIDIA_TOP_P=0.95
NVIDIA_MAX_TOKENS=8192
NVIDIA_TIMEOUT_MS=360000              # 6 min absolute backstop per request
NVIDIA_IDLE_TIMEOUT_MS=45000          # abort if NO token arrives for this long (fast failover on a stalled request; streaming generations reset it per token so healthy-but-slow runs are never cut off)
NVIDIA_MAX_RETRIES=1
NVIDIA_CONCURRENCY=5
NVIDIA_REASONING=off                  # nemotron 'detailed thinking on|off' (keep off for JSON)

# ── PPT fast-path tuning (v7 — sub-10-min generation) ────────────────────────
RASTER_MAX_PAGES=160                   # max scanned pages rasterized/doc (must cover the 160-slide ceiling: a page past this cap = a missing slide in redesign)
PPT_PLANNING_MODEL=fast               # knowledge extraction + lecture outline: fast | generation (fast = big speed win, output is teacher-reviewed)
PPT_SLIDE_MODEL=generation            # GENERATE-mode slide content: generation (quality) | fast (speed)
PPT_REDESIGN_SLIDE_MODEL=fast         # REDESIGN slides reformat the page's own verbatim text (mechanical) — fast turns a 92-slide deck from ~40 min into ~4; 'generation' restores max polish
PPT_SLIDE_CONCURRENCY=6               # parallel slide-generation calls (slides are independent)
RASTER_CONCURRENCY=3                  # scanned pages rasterized in parallel (CPU/memory bounded)
PPT_REVIEW_SLIDES=off                 # per-slide hallucination reviewer adds a 2nd LLM call/slide; on = max quality, off = ~2x faster
PPT_EXTRACT_MAX_BATCHES=6             # cap knowledge-extraction LLM calls (a lecture needs the chapter, not the whole book)

# Optional cost tracking (USD per 1M tokens; 0 = unknown)
NVIDIA_COST_INPUT_PER_M=0
NVIDIA_COST_OUTPUT_PER_M=0

# Ollama (local fallback / offline mode)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_VISION_MODEL=                  # optional local VLM for vision fallback (e.g. llama3.2-vision)

# ── AI job queue (async, BullMQ + Redis — see src/workers/pptWorkerCore.ts) ──
# Runs BOTH ppt and question-paper generations. The worker runs EMBEDDED in the
# API server by default: `npm start` alone is a complete deployment. To isolate
# the CPU-heavy pipeline instead, set PPT_WORKER_EMBEDDED=false here and run
# `npm run start:worker:ppt` (or dev:worker:ppt) as its own process.
PPT_WORKER_EMBEDDED=true
PPT_WORKER_CONCURRENCY=2              # concurrent ai jobs per worker instance
VISION_MAX_PAGES=24                   # cap per-page vision noise-classification calls (redesign mode)
# Question papers generate in the background (202 + poll) like ppt — a 5-15 min
# generation must not ride one mobile XHR. Set 'off' to restore the old
# synchronous single-request behavior.
PAPER_ASYNC=on
# IMPORTANT when local dev and production share one Redis: give each
# environment its own queue name, or the other environment's (possibly
# stale-code) worker will steal your jobs. Leave production on the default.
# AI_QUEUE_NAME=ai-pipeline-dev

# ── HTML→PDF export (question papers, PPT PDF export) ────────────────────────
# utils/launchBrowser.ts resolution order: installed Chrome/Edge/Chromium
# (env override → standard paths → PATH scan, incl. the nix profile Railway's
# nixpacks.toml installs chromium into) → @sparticuz/chromium → puppeteer.
# Only needed when the binary lives somewhere non-standard:
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# ── OCR (scanned PDFs / images — automatic routing, native PDFs never hit OCR) ──
NVIDIA_OCR_URL_BASE=https://ai.api.nvidia.com/v1/cv
NVIDIA_OCR_PRIMARY=nvidia/nemotron-ocr-v2
NVIDIA_OCR_RETRY=nvidia/nemoretriever-ocr-v1
NVIDIA_OCR_FALLBACK=nvidia/nemotron-ocr-v1
OCR_MIN_CONFIDENCE=0.6                # overall page confidence below this → try the next model in the chain
OCR_DETECTION_MIN_CONFIDENCE=0.55    # drop individual text regions below this before reconstruction
OCR_MAX_PAGES=200                      # scanned pages processed per document
OCR_CONCURRENCY=4                     # scanned pages OCR'd in parallel (bounded)
OCR_TIMEOUT_MS=90000

# ── RAG (PPT retrieval — embeddings + reranker; degrades gracefully if absent) ──
NVIDIA_MODEL_EMBEDDING=nvidia/llama-nemotron-embed-1b-v2
NVIDIA_MODEL_RERANK=nvidia/llama-3.2-nv-rerankqa-1b-v2
# NVIDIA_RERANK_URL=                  # full override if the invoke-URL pattern changes

# ── Import engine (Smart Import) performance ─────────────────────────────────
AI_ENHANCER_CONCURRENCY=6            # parallel AI requests for cloud (NVIDIA); auto-1 for Ollama
AI_ENHANCER_BATCH_SIZE=4             # questions per AI request for cloud; auto-1 for Ollama
# Enhancement model (NVIDIA path). Defaults to the QUALITY generation model —
# extraction fidelity is critical (a dropped "(Given:)" clause or wrong
# subscript is a failure) and the fast model proved lossy. Speed comes from
# per-question parallelism (AI_ENHANCER_CONCURRENCY), not a weaker model.
# Override to the fast model ONLY if you accept lower fidelity for speed:
# AI_ENHANCER_MODEL_NVIDIA=nvidia/nvidia-nemotron-nano-9b-v2
AI_ENHANCER_MAX_RETRIES=2            # per-block retries before fail-soft (keep raw + needsReview)
IMPORT_CACHE_ENABLED=true           # cache extracted/enhanced results in Redis
IMPORT_CACHE_TTL_DAYS=30
# Frontend (cbt-exam) poll interval for live progress:
#   NEXT_PUBLIC_IMPORT_POLL_MS=1500

# ── Schedule validation policy (institute business rules) ────────────────────
# Owned by src/services/schedule/schedulePolicy.ts; the rule engine
# (scheduleValidator.ts) hardcodes no institute assumptions of its own. All
# three write paths — manual create, manual edit, AI bulk import — read these.
#
# Combined batch sessions: one class whose batches sit together in ONE room at
# the SAME time (11th JEE B1 + 11th JEE B2, both "Archit sir, Room 4"). Valid
# here, so it is NOT reported as a room/teacher clash. Set false to fall back to
# generic school-scheduling behaviour.
# SCHEDULE_ALLOW_COMBINED_BATCHES=true
# A combined session is one teacher taking both batches, so the shared teacher
# is exempt too. Set false to keep flagging the shared teacher.
# SCHEDULE_COMBINED_SHARES_TEACHER=true
# Require the same room for the exemption. Keep true — it is what stops one
# teacher listed against two batches in two DIFFERENT rooms from being excused.
# SCHEDULE_COMBINED_REQUIRES_SAME_ROOM=true
#
# Individual rules (set false to stop blocking on them entirely):
# SCHEDULE_BLOCK_ROOM_DOUBLE_BOOKING=true
# SCHEDULE_BLOCK_TEACHER_DOUBLE_BOOKING=true
# SCHEDULE_BLOCK_TEACHER_ON_LEAVE=true
# Physical rooms available to schedule into:
# SCHEDULE_ROOM_MIN=1
# SCHEDULE_ROOM_MAX=11

# Firebase Admin
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# Rate Limiting (optional overrides)
MAX_CONNECTIONS=10000
MAX_ROOMS_PER_SOCKET=50
MAX_MESSAGES_PER_MINUTE=30
