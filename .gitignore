.env

# Dependencies
node_modules/

# Build output
dist/
build/

# Editor directories
.vscode/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store

# Lockfiles (optional to ignore)
package-lock.json

#keys
vision-key.json
firebase-admin.json

google-services.json

# Database backups produced by scripts/safety/db-backup.ts.
# These contain full production data — every user record, every attempt, every
# doubt message. They must never enter git history, where they would be
# effectively impossible to remove from every clone and fork.
# The MANIFEST is also excluded: its per-collection fingerprints are harmless,
# but keeping the whole directory out is one rule instead of two, and a rule
# with an exception is a rule someone gets wrong at 2am.
backups/
*.ejson